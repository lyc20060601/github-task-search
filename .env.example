# Copy this file to .env and replace placeholders with your own credentials.
# Never commit .env or put real credentials in README, Dockerfiles, or images.

GITHUB_TOKEN=your_github_token_here
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Browser-visible backend URL. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Runtime validation is enabled only by the lifecycle scripts.
VALIDATION_MODE=disabled
