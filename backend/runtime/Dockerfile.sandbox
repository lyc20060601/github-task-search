FROM mcr.microsoft.com/devcontainers/python:1-3.12-bookworm

RUN groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin sandbox \
    && mkdir -p /workspace \
    && chown 10001:10001 /workspace

WORKDIR /workspace
USER 10001:10001

CMD ["python", "--version"]
